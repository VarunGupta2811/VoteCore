# Copy this file to backend/.env and replace the values before starting the server.
DB_USER=your_oracle_username
DB_PASSWORD=your_oracle_password
DB_DSN=your_oracle_dsn
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Gmail example: use a Google App Password, not your normal Gmail password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=45
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
